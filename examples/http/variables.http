# File-level variables (shared across all requests)
@base_url = https://httpbin.org
@timeout = 30

### GET request with file variables
GET {{base_url}}/get?timeout={{timeout}}

### POST with request-level variables
@user_id = 123
@user_name = John Doe
POST {{base_url}}/post
Content-Type: application/json

{
  "user_id": "{{user_id}}",
  "name": "{{user_name}}",
  "timeout": {{timeout}}
}

### Variable priority test
@host = request-level.com
GET https://{{host}}/anything

### POST with request-level variables
@user_id = 123
@user_name = John Doe
POST {{base_url}}/post
Content-Type: application/json

{
  "user_id": "{{user_id}}",
  "name": "{{user_name}}",
  "timeout": {{timeout}}
}



### POST with random variables
< {%
  local randInt = math.random(5, 8);
  request.variables.set('userId', randInt);
  math.randomseed(os.time());
  local names = {"Jack", "Jhon", "Rose", "Doe"};
  local name = names[math.random(#names)];
  request.variables.set('name', name);
%}
@base_url = http://localhosot:8888
POST {{base_url}}/anything
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "name": "{{name}}",
  "timestamp": {{$timestamp}}
}


