# File-level variables are shared by every request in this file;
# a request-level @var (inside a block) overrides them for that block only.

@base_url = http://localhost:8888
@timeout = 30

### GET with file variables
GET {{base_url}}/get?timeout={{timeout}}

### POST with request-level variables
@user_id = 123
@user_name = John Doe
POST {{base_url}}/post
Content-Type: application/json

{
  "user_id": "{{user_id}}",
  "name": "{{user_name}}",
  "timeout": {{timeout}}
}

### Request-level @base_url overrides the file-level one
# Only this block talks to 127.0.0.1; the file-level value is unchanged.
@base_url = http://127.0.0.1:8888
GET {{base_url}}/anything/override-demo

### Random values from a pre-request script
< {%
  math.randomseed(os.time())
  local randInt = math.random(5, 8)
  request.variables.set('userId', randInt)
  local names = {"Jack", "John", "Rose", "Doe"}
  request.variables.set('name', names[math.random(#names)])
%}
POST {{base_url}}/anything/random-vars
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "name": "{{name}}",
  "timestamp": {{$timestamp}}
}
