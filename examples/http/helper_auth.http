# Import helper for the import/run tests
# Requests are imported into feature_suite.http via `import ./helper_auth.http as auth`

@base_url = http://localhost:8888
@token = file_token

### Login
POST {{base_url}}/post
Content-Type: application/json

{
  "password": "secret123",
  "username": "admin"
}

> {%
  client.log('username: ' .. response.body.json.username)
%}

### LoginWithToken
@token = request_token
POST {{base_url}}/post
Content-Type: application/json

{
  "password": "{{token}}",
  "username": "admin"
}

### Profile
GET {{base_url}}/get?user_id=42&role=admin
